<%- include('partials/head', { site: site, pageTitle: 'Home', pageDescription: pageDescription, canonicalUrl: canonicalUrl, structuredData: structuredData, active: 'home' }) %>

<section class="hero-tile tile">
  <div class="hero-tile__photo">
    <img src="/images/samuel-avatar.webp" alt="Samuel Dvorak in the cockpit, headset on" width="120" height="120">
  </div>
  <div>
    <h1><%= site.siteTitle %></h1>
    <p class="tagline"><%= site.tagline %></p>
  </div>
</section>

<section class="bio-tile tile" aria-label="About Samuel">
  <p class="bio-tile__label">About</p>
  <% site.bio.forEach(function(paragraph) { %>
    <p><%= paragraph %></p>
  <% }); %>
</section>

<section class="contact-tile tile" id="contact" aria-labelledby="contact-heading">
  <h2 id="contact-heading">Get in touch</h2>
  <p>Questions about flight training, ground school, or career road map?</p>
  <button type="button" class="contact-tile__cta" id="open-contact-dialog">Send a message</button>
</section>

<dialog id="contact-dialog" class="contact-dialog">
  <form id="contact-form" novalidate>
    <h2>Send a message</h2>

    <label for="contact-name">Name</label>
    <input type="text" id="contact-name" name="name" required autocomplete="name" maxlength="100">

    <label for="contact-email">Email</label>
    <input type="email" id="contact-email" name="email" required autocomplete="email" maxlength="200">

    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" rows="5" required maxlength="5000"></textarea>

    <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">

    <p class="contact-form__message" id="contact-form-message" role="status"></p>

    <div class="contact-form__actions">
      <button type="button" class="contact-form__cancel" id="close-contact-dialog">Cancel</button>
      <button type="submit" class="contact-form__submit" id="contact-form-submit">Send</button>
    </div>

    <p class="contact-form__alt">Prefer your own email app? <a id="contact-email-link" href="#" data-user="<%= site.contact.user %>" data-domain="<%= site.contact.domain %>">Email me directly</a></p>
    <p class="contact-tile__status" id="contact-status" role="status"></p>
  </form>
</dialog>

<%- include('partials/foot', { site: site }) %>
