<%- include('partials/head', { site: site, pageTitle: 'Reviews', pageDescription: pageDescription, canonicalUrl: canonicalUrl, active: active }) %>

<h1>Reviews</h1>
<p class="resource-section__hint">What students have said, and a few milestones along the way, from training at Brazos Valley Flight Services.</p>

<%
  function initials(name) {
    return name.split(' ').map(function(p) { return p[0]; }).join('').slice(0, 2).toUpperCase();
  }
  function stars(rating) {
    return '★★★★★☆☆☆☆☆'.slice(5 - rating, 10 - rating);
  }
%>

<% if (reviews.length === 0) { %>
  <p class="empty-state">Nothing here yet — check back soon.</p>
<% } else { %>
  <ul class="review-grid">
    <% reviews.forEach(function(review) { %>
      <li class="review-card tile">
        <% if (review.reviewerName) { %>
          <div class="review-card__header">
            <div class="review-card__avatar"><%= initials(review.reviewerName) %></div>
            <div>
              <p class="review-card__name"><%= review.reviewerName %></p>
              <p class="review-card__meta"><span class="review-card__stars"><%= stars(review.rating) %></span> <%= review.reviewDate %></p>
            </div>
          </div>
        <% } %>
        <% if (review.text) { %>
          <p class="review-card__text"><%= review.text %></p>
        <% } %>
        <% if (review.photo) { %>
          <img class="review-card__photo-img" src="<%= review.photo %>" alt="<%= review.caption || (review.reviewerName ? review.reviewerName + ' with Samuel' : 'Student photo') %>" loading="lazy">
        <% } %>
        <% if (review.caption) { %>
          <p class="review-card__caption"><%= review.caption %></p>
        <% } %>
      </li>
    <% }); %>
  </ul>
<% } %>

<%- include('partials/foot', { site: site }) %>
