<%- include('partials/head', { site: site, pageTitle: 'Reviews', pageDescription: pageDescription, canonicalUrl: canonicalUrl, active: active }) %>

<h1>Reviews</h1>
<p class="resource-section__hint">What students have said, and a few milestones along the way, from training at Brazos Valley Flight Services.</p>

<%
  // Falls back to the old photo/no-photo split for reviews saved before
  // columns became a stored field.
  const columnOf = function(r) { return r.column || (r.photo ? 'right' : 'left'); };
  const leftReviews = reviews.filter(function(r) { return columnOf(r) === 'left'; });
  const rightReviews = reviews.filter(function(r) { return columnOf(r) === 'right'; });
%>

<% if (reviews.length === 0) { %>
  <p class="empty-state">Nothing here yet — check back soon.</p>
<% } else { %>
  <div class="review-columns">
    <ul class="review-column review-column--left">
      <% leftReviews.forEach(function(review) { %>
        <%- include('partials/review-card', { review: review }) %>
      <% }); %>
    </ul>
    <ul class="review-column review-column--right">
      <% rightReviews.forEach(function(review) { %>
        <%- include('partials/review-card', { review: review }) %>
      <% }); %>
    </ul>
  </div>
<% } %>

<%- include('partials/foot', { site: site }) %>
