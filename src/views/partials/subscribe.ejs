<section class="subscribe tile" aria-labelledby="subscribe-heading">
  <h2 id="subscribe-heading">Get notified when I post</h2>
  <p>New articles, study resources, and videos, straight to your inbox. Unsubscribe anytime.</p>
  <form class="subscribe__form" id="subscribe-form" novalidate>
    <label class="hp-field" for="subscribe-email">Email address</label>
    <input type="email" id="subscribe-email" name="email" placeholder="you@example.com" autocomplete="email" required>
    <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
    <button type="submit" class="subscribe__submit" id="subscribe-submit">Notify me</button>
  </form>
  <p class="subscribe__message" id="subscribe-message" role="status"></p>
</section>
