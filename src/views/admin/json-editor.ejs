<%- include('partials/head', { title: title }) %>

<div class="admin-card">
  <p><a href="<%= backLink %>">&larr; Back</a></p>
  <h1><%= title %></h1>
  <p class="hint">Raw JSON editor. Keep the structure the same &mdash; only edit the text values.</p>

  <% if (saved) { %>
    <p class="admin-message admin-message--success">Saved.</p>
  <% } %>
  <% if (error) { %>
    <p class="admin-message admin-message--error"><%= error %></p>
  <% } %>

  <form method="post" action="<%= actionUrl %>" class="admin-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <textarea name="json" class="admin-form__code" spellcheck="false"><%= raw %></textarea>
    <button type="submit" class="admin-btn">Save</button>
  </form>
</div>

<%- include('partials/foot') %>
