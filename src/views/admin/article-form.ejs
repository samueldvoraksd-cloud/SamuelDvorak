<%- include('partials/head', { title: mode === 'new' ? 'New article' : 'Edit article' }) %>

<div class="admin-card">
  <p><a href="/admin/articles">&larr; Back to articles</a></p>
  <h1><%= mode === 'new' ? 'New article' : 'Edit article' %></h1>

  <% if (error) { %>
    <p class="admin-message admin-message--error"><%= error %></p>
  <% } %>

  <form method="post" action="<%= mode === 'new' ? '/admin/articles/new' : '/admin/articles/' + article.slug + '/edit' %>" class="admin-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="title">Title</label>
    <textarea id="title" name="title" class="admin-autosize" rows="1" required><%= article.title %></textarea>

    <label for="slug">Slug (lowercase, hyphens only &mdash; this becomes the URL)</label>
    <input type="text" id="slug" name="slug" value="<%= article.slug %>" pattern="[a-z0-9]+(-[a-z0-9]+)*" required>

    <label for="date">Date</label>
    <input type="date" id="date" name="date" value="<%= article.date %>" required>

    <label for="excerpt">Excerpt (shown on the articles list page)</label>
    <textarea id="excerpt" name="excerpt" class="admin-autosize" rows="1" required><%= article.excerpt %></textarea>

    <label for="body">Body (Markdown)</label>
    <textarea id="body" name="body" class="admin-form__body" required><%= article.body %></textarea>

    <button type="submit" class="admin-btn">Save</button>
  </form>
</div>

<%- include('partials/foot') %>
