<%- include('partials/head', { title: 'Reorder reviews', bodyClass: 'admin-wide' }) %>

<div class="admin-card">
  <p><a href="/admin/reviews">&larr; Back to reviews content</a></p>
  <h1>Reorder reviews</h1>
  <p class="hint">This is exactly how the public reviews page looks. Drag any card anywhere &mdash; up, down, or across to the other column &mdash; then click Save order. Spacing stays consistent automatically; you're choosing each card's position, not its margins.</p>

  <% if (githubConfigured) { %>
    <p class="admin-notice">Saving here goes live immediately but only exists on this server until you click <strong>Publish changes</strong> (top of the page).</p>
  <% } else { %>
    <p class="admin-notice">GitHub sync isn't configured. Order changes here are saved to this server's disk only, which Render's free tier wipes on redeploy or after the site's been idle.</p>
  <% } %>

  <% if (saved) { %>
    <p class="admin-message admin-message--success">Order saved.</p>
  <% } %>
</div>

<%
  // Falls back to the old photo/no-photo split for reviews saved before
  // columns became a stored field.
  const leftReviews = [];
  const rightReviews = [];
  reviews.forEach(function (review, i) {
    const column = review.column || (review.photo ? 'right' : 'left');
    (column === 'right' ? rightReviews : leftReviews).push({ review, index: i });
  });
%>

<form method="post" action="/admin/reviews/order" id="reorder-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="order" id="order-field" value="">

  <% if (reviews.length === 0) { %>
    <p class="empty-state">Nothing here yet &mdash; add reviews first.</p>
  <% } else { %>
    <div class="review-columns" id="review-columns">
      <ul class="review-column review-column--left review-column--sortable" data-column="left">
        <% leftReviews.forEach(function(item) { %>
          <%- include('../partials/review-card', { review: item.review, withHandle: true, index: item.index }) %>
        <% }); %>
      </ul>
      <ul class="review-column review-column--right review-column--sortable" data-column="right">
        <% rightReviews.forEach(function(item) { %>
          <%- include('../partials/review-card', { review: item.review, withHandle: true, index: item.index }) %>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <div class="admin-card">
    <button type="submit" class="admin-btn">Save order</button>
  </div>
</form>

<script>
  (function () {
    const columns = document.getElementById('review-columns');
    if (!columns) return;

    let draggingCard = null;

    columns.addEventListener('dragstart', function (event) {
      const card = event.target.closest('.review-card');
      if (!card) return;
      draggingCard = card;
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/plain', '');
      event.dataTransfer.setDragImage(card, 20, 20);
      requestAnimationFrame(function () { card.classList.add('is-dragging'); });
    });

    // The card the cursor sits above, so the dragged card slots in before it.
    // Returns null past the last card, which appends to the end.
    function cardAfterCursor(column, y) {
      return Array.from(column.querySelectorAll('.review-card:not(.is-dragging)'))
        .find(function (card) {
          const rect = card.getBoundingClientRect();
          return y < rect.top + rect.height / 2;
        }) || null;
    }

    columns.addEventListener('dragover', function (event) {
      if (!draggingCard) return;
      const column = event.target.closest('.review-column');
      if (!column) return;
      event.preventDefault();
      column.insertBefore(draggingCard, cardAfterCursor(column, event.clientY));
    });

    columns.addEventListener('dragend', function () {
      if (draggingCard) {
        draggingCard.classList.remove('is-dragging');
      }
      draggingCard = null;
    });

    document.getElementById('reorder-form').addEventListener('submit', function () {
      const indicesIn = function (column) {
        return Array.from(column.querySelectorAll('.review-card[data-original-index]'))
          .map(function (card) { return Number(card.getAttribute('data-original-index')); });
      };
      document.getElementById('order-field').value = JSON.stringify({
        left: indicesIn(columns.querySelector('[data-column="left"]')),
        right: indicesIn(columns.querySelector('[data-column="right"]')),
      });
    });
  })();
</script>

<%- include('partials/foot') %>
