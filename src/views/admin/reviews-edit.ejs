<%- include('partials/head', { title: 'Reviews page content' }) %>

<div class="admin-card">
  <p><a href="/admin">&larr; Back</a></p>
  <h1>Reviews page content</h1>

  <% if (githubConfigured) { %>
    <p class="admin-notice">Saving here goes live immediately but only exists on this server until you click <strong>Publish changes</strong> (top of the page). Publishing commits everything &mdash; including uploaded images &mdash; to GitHub and redeploys automatically.</p>
  <% } else { %>
    <p class="admin-notice">GitHub sync isn't configured. Uploaded images and edits here are saved to this server's disk only, which Render's free tier wipes on redeploy or after the site's been idle.</p>
  <% } %>

  <% if (saved) { %>
    <p class="admin-message admin-message--success">Saved.</p>
  <% } %>

  <p class="hint">Drag a card by its <strong>⠿</strong> handle to change the order reviews appear in on the public page.</p>

  <form method="post" action="/admin/reviews" class="admin-form" id="reviews-form" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div id="reviews-rows">
      <% reviews.forEach(function(review, i) { %>
        <div class="admin-row admin-row--sortable">
          <button type="button" class="admin-row__handle" aria-label="Drag to reorder">&#10303;</button>
          <button type="button" class="admin-row__remove" aria-label="Remove review">&times;</button>

          <label>Reviewer name</label>
          <input type="text" name="reviews[<%= i %>][reviewerName]" value="<%= review.reviewerName %>">

          <label>Rating (1&ndash;5)</label>
          <select name="reviews[<%= i %>][rating]">
            <% for (let r = 5; r >= 1; r--) { %>
              <option value="<%= r %>" <%= String(review.rating) === String(r) ? 'selected' : '' %>><%= r %> star<%= r === 1 ? '' : 's' %></option>
            <% } %>
          </select>

          <label>Date shown (e.g. "September 2026")</label>
          <input type="text" name="reviews[<%= i %>][reviewDate]" value="<%= review.reviewDate %>">

          <label>Review text</label>
          <textarea class="admin-autosize" rows="2" name="reviews[<%= i %>][text]"><%= review.text %></textarea>

          <label>Photo (optional)</label>
          <input type="hidden" name="reviews[<%= i %>][photo]" value="<%= review.photo %>">
          <% if (review.photo) { %>
            <p class="admin-dropzone__current" data-current-line="photo">
              Current: <a href="<%= review.photo %>" target="_blank" rel="noopener"><%= review.photo.split('/').pop() %></a>
              &mdash;
              <button type="button" class="js-clear-file" data-target-field="photo" data-default-label="Drag a photo here or click to browse">Remove</button>
            </p>
          <% } %>
          <div class="admin-dropzone" data-field="photo">
            <input type="file" accept="image/*" name="reviews[<%= i %>][photoUpload]">
            <span class="admin-dropzone__label"><%= review.photo ? 'Drag a new photo here to replace, or click to browse' : 'Drag a photo here or click to browse' %></span>
          </div>

          <label>Caption (optional)</label>
          <textarea class="admin-autosize" rows="1" name="reviews[<%= i %>][caption]"><%= review.caption %></textarea>
        </div>
      <% }); %>
    </div>
    <button type="button" class="admin-btn admin-btn--secondary" id="add-review">+ Add review</button>

    <p><button type="submit" class="admin-btn">Save</button></p>
  </form>
</div>

<template id="review-row-template">
  <div class="admin-row admin-row--sortable">
    <button type="button" class="admin-row__handle" aria-label="Drag to reorder">&#10303;</button>
    <button type="button" class="admin-row__remove" aria-label="Remove review">&times;</button>

    <label>Reviewer name</label>
    <input type="text" name="reviews[__INDEX__][reviewerName]">

    <label>Rating (1&ndash;5)</label>
    <select name="reviews[__INDEX__][rating]">
      <option value="5" selected>5 stars</option>
      <option value="4">4 stars</option>
      <option value="3">3 stars</option>
      <option value="2">2 stars</option>
      <option value="1">1 star</option>
    </select>

    <label>Date shown (e.g. "September 2026")</label>
    <input type="text" name="reviews[__INDEX__][reviewDate]">

    <label>Review text</label>
    <textarea class="admin-autosize" rows="2" name="reviews[__INDEX__][text]"></textarea>

    <label>Photo (optional)</label>
    <input type="hidden" name="reviews[__INDEX__][photo]" value="">
    <div class="admin-dropzone" data-field="photo">
      <input type="file" accept="image/*" name="reviews[__INDEX__][photoUpload]">
      <span class="admin-dropzone__label">Drag a photo here or click to browse</span>
    </div>

    <label>Caption (optional)</label>
    <textarea class="admin-autosize" rows="1" name="reviews[__INDEX__][caption]"></textarea>
  </div>
</template>

<script>
  (function () {
    let nextIndex = 100000; // stays clear of existing server-rendered indices

    document.getElementById('add-review').addEventListener('click', function () {
      const container = document.getElementById('reviews-rows');
      const template = document.getElementById('review-row-template');
      const html = template.innerHTML.replaceAll('__INDEX__', String(nextIndex++));
      const wrapper = document.createElement('div');
      wrapper.innerHTML = html.trim();
      const row = wrapper.firstElementChild;
      container.appendChild(row);
      row.querySelectorAll('.admin-autosize').forEach(function (el) {
        el.dispatchEvent(new Event('input'));
      });
    });

    document.getElementById('reviews-form').addEventListener('click', function (event) {
      if (event.target.classList.contains('admin-row__remove')) {
        event.target.closest('.admin-row').remove();
      }
    });

    function renumberReviewRows() {
      document.querySelectorAll('#reviews-rows .admin-row').forEach(function (row, idx) {
        row.querySelectorAll('[name]').forEach(function (el) {
          el.name = el.name.replace(/^reviews\[\d+\]/, 'reviews[' + idx + ']');
        });
      });
    }

    let draggingRow = null;

    document.getElementById('reviews-rows').addEventListener('mousedown', function (event) {
      const handle = event.target.closest('.admin-row__handle');
      if (!handle) return;
      const row = handle.closest('.admin-row');
      if (row) row.setAttribute('draggable', 'true');
    });

    document.getElementById('reviews-rows').addEventListener('dragstart', function (event) {
      const row = event.target.closest('.admin-row');
      if (!row || row.getAttribute('draggable') !== 'true') return;
      draggingRow = row;
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/plain', '');
      requestAnimationFrame(function () { row.classList.add('is-dragging'); });
    });

    document.getElementById('reviews-rows').addEventListener('dragover', function (event) {
      if (!draggingRow) return;
      const row = event.target.closest('.admin-row');
      const container = document.getElementById('reviews-rows');
      if (!row || row === draggingRow || !container.contains(row)) return;
      event.preventDefault();
      const rect = row.getBoundingClientRect();
      const after = (event.clientY - rect.top) > rect.height / 2;
      container.insertBefore(draggingRow, after ? row.nextSibling : row);
    });

    document.getElementById('reviews-rows').addEventListener('dragend', function () {
      if (draggingRow) {
        draggingRow.removeAttribute('draggable');
        draggingRow.classList.remove('is-dragging');
        renumberReviewRows();
      }
      draggingRow = null;
    });
  })();
</script>

<%- include('partials/foot') %>
